+async function copyWebServerSourceInputs(
+  workspaceRoot: string,
+  paths: LinuxPaths,
+): Promise<void> {
+  const mirrorRoot = join(paths.assembledAppRoot, "node_modules");
+  for (const entry of WEB_SERVER_SOURCE_INPUTS) {
+    const source = join(workspaceRoot, entry.from);
+    if (!(await exists(source))) continue;
+    const destination = join(mirrorRoot, entry.to);
+    await mkdir(dirname(destination), { recursive: true });
+    await copyFile(source, destination);
+  }
