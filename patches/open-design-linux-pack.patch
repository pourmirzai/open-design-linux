+
+// The web sidecar runs Next.js in server output mode on Linux (config/index.ts
+// forces "server"), so the packaged web package's next.config.ts is re-loaded at
+// runtime. Its module scope computes WORKSPACE_ROOT as the grandparent of the
+// installed web package (node_modules/) and reads the CMS host-release
+// fingerprint inputs at <WORKSPACE_ROOT>/apps/web/... and
+// <WORKSPACE_ROOT>/packages/contracts/... — paths that only exist in the build
+// workspace, not inside an assembled package, so the config throws ENOENT and
+// takes the web sidecar (and the whole packaged boot) down with it.
+//
+// Fix inside the packaged @open-design/web directory (which electron-builder
+// copies wholesale): copy every fingerprint input under .od-cms-inputs/ and
+// rewrite the config's read to resolve from WEB_ROOT. Content is irrelevant —
+// the build-time fingerprint baked into .next is authoritative — only the reads
+// must succeed.
+const CMS_FINGERPRINT_INPUTS = [
+  "apps/web/app/layout.tsx",
+  "apps/web/src/App.tsx",
+  "apps/web/src/components/EntryNavRail.tsx",
+  "apps/web/src/components/EntryShell.tsx",
+  "apps/web/src/components/touchpoint-component.ts",
+  "apps/web/src/components/touchpoint-lifecycle.ts",
+  "apps/web/src/components/touchpoint-static-actions.ts",
+  "apps/web/src/components/touchpoint-navigation.ts",
+  "apps/web/src/components/TestCampaignModal.tsx",
+  "apps/web/src/components/TestCampaignModal.module.css",
+  "apps/web/src/components/ProductionCampaignModal.tsx",
+  "apps/web/src/components/ProductionCampaignBadge.tsx",
+  "apps/web/src/components/ProductionCampaignBadge.module.css",
+  "apps/web/src/components/ProductionCampaignHover.tsx",
+  "apps/web/src/components/HoverTouchpointOverlay.tsx",
+  "apps/web/src/components/HoverTouchpointOverlay.module.css",
+  "apps/web/src/components/production-touchpoint-loader.ts",
+  "packages/contracts/src/touchpoint-component-v2.ts",
+] as const;
+
+async function copyWebServerSourceInputs(
+  workspaceRoot: string,
+  paths: LinuxPaths,
+): Promise<void> {
+  const webPackageRoot = join(paths.assembledAppRoot, "node_modules", "@open-design", "web");
+  const inputsRoot = join(webPackageRoot, ".od-cms-inputs");
+  await mkdir(inputsRoot, { recursive: true });
+  for (const relative of CMS_FINGERPRINT_INPUTS) {
+    const source = join(workspaceRoot, relative);
+    if (!(await access(source).then(() => true, () => false))) continue;
+    const destination = join(inputsRoot, `${relative.replaceAll("/", "__")}`);
+    await copyFile(source, destination);
+  }
+  const configPath = join(webPackageRoot, "next.config.ts");
+  const config = await readFile(configPath, "utf8");
+  const rewritten = config
+    .replaceAll(
+      "readFileSync(resolve(WORKSPACE_ROOT, file))",
+      "readFileSync(resolve(WEB_ROOT, '.od-cms-inputs', file.replaceAll('/', '__')))",
+    )
+    .replaceAll(
+      "existsSync(resolve(WEB_ROOT, 'src/components/touchpoint-component.ts'))",
+      "existsSync(resolve(WEB_ROOT, '.od-cms-inputs', 'apps__web__src__components__touchpoint-component.ts'))",
+    );
+  if (rewritten !== config) {
+    await writeFile(configPath, rewritten, "utf8");
+  }
 }
 
