+  // pnpm resolves transitive dependencies of file: tarballs against the npm
+  // registry, and the internal @open-design/* packages are not published, so a
+  // hoisted production install would 404. Write a workspace config whose
+  // overrides pin every internal package to its packed tarball, and whose
+  // onlyBuiltDependencies keeps native runtime deps (better-sqlite3) building
+  // despite pnpm 10's default script block.
+  const overrides: Record<string, string> = {};
+  for (const tarball of packed) {
+    overrides[tarball.packageName] = `file:${join(paths.tarballsRoot, tarball.fileName)}`;
+  }
+  const overrideYamlLines = ["overrides:"];
+  for (const [name, spec] of Object.entries(overrides)) {
+    overrideYamlLines.push(`  "${name}": "${spec}"`);
+  }
+  overrideYamlLines.push("onlyBuiltDependencies:");
+  for (const dep of ["better-sqlite3", "core-js", "esbuild", "protobufjs", "sharp"]) {
+    overrideYamlLines.push(`  - ${dep}`);
+  }
+
